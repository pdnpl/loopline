{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "NotebookEdit",
      "TodoWrite",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(node *)",
      "Bash(tsc *)",
      "Bash(vite *)",
      "Bash(vitest *)",
      "Bash(eslint *)",
      "Bash(prettier *)",
      "Bash(wrangler *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(rm *)",
      "Bash(find *)",
      "Bash(echo *)",
      "Bash(jq *)",
      "Bash(curl *)",
      "Bash(sed *)",
      "Bash(grep *)",
      "PowerShell(npm *)",
      "PowerShell(npx *)",
      "PowerShell(pnpm *)",
      "PowerShell(node *)",
      "PowerShell(git *)",
      "PowerShell(gh *)",
      "PowerShell(wrangler *)",
      "PowerShell(Get-*)",
      "PowerShell(Test-Path *)",
      "PowerShell(New-Item *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(Copy-Item *)",
      "PowerShell(Move-Item *)",
      "PowerShell(Select-Object *)",
      "PowerShell(Measure-Object *)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf /*)",
      "Bash(git push --force origin main*)",
      "Bash(git push -f origin main*)",
      "Bash(gh repo delete *)",
      "Bash(npm publish*)",
      "PowerShell(Remove-Item -Recurse -Force C:\\)",
      "PowerShell(Format-Volume *)"
    ]
  },
  "autoCompactEnabled": true,
  "fileCheckpointingEnabled": true,
  "includeCoAuthoredBy": true
}
