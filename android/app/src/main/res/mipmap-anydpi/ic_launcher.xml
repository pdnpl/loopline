<?xml version="1.0" encoding="utf-8"?>
<!--
  The legacy launcher icon, for API 24-25, which predate adaptive icons.
  API 26+ picks mipmap-anydpi-v26 instead: a version qualifier is more specific,
  so the adaptive form wins wherever it is understood.

  A layer-list rather than a fourth copy of the geometry — the foreground is
  already inset for the adaptive canvas, so it drops straight onto a board of
  the same size.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/ic_launcher_bg_square" />
    <item android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
