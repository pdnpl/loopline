<?xml version="1.0" encoding="utf-8"?>
<!--
  The Loopline mark, as the adaptive icon's foreground layer.

  Same path as the wordmark in index.html, mapped from its 24x24 viewBox into
  the 108x108 adaptive canvas at 3.3x. The scale is chosen so the furthest
  corner sits ~30 units from centre, inside the 33-unit radius a circular mask
  keeps — a larger mark would have its ends clipped on a round launcher.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M30.9,73.8 L30.9,34.2 L54,54 L77.1,34.2 L77.1,73.8"
        android:fillColor="#00000000"
        android:strokeColor="#818CF8"
        android:strokeWidth="7.3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
